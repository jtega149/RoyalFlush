# Example env file for client set up
# Leave VITE_API_URL unset (or empty) to use same-origin API paths (/auth, /reviews, /api).
# Vite dev server proxies those paths to localhost:3001.
# Set VITE_API_URL=http://localhost:3001 only if you want to bypass the dev proxy.
# VITE_API_URL=
VITE_GOOGLE_MAPS_API_KEY=
